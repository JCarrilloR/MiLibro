if pgrep -x diamond >/dev/null ||
   pgrep -f '/humannpip/bin/humann' >/dev/null; then
    echo "ERROR: hay un análisis activo de DIAMOND o HUMAnN."
    exit 1
fi

[[ -s "$FASTA" && -s "$DB" ]] || {
    echo "ERROR: falta el FASTA o la base de datos."
    exit 1
}

[[ ! -e "$CHUNKS" && ! -e "$RESULTADOS" ]] || {
    echo "ERROR: ya existen carpetas de fragmentos o resultados de C6."
    echo "Revisar antes de repetir."
    exit 1
}

mkdir -p "$CHUNKS"
mkdir -p "$RESULTADOS"/{alignments,logs,tmp,completed}

# 30.3. Extraer el primer fragmento.
## Leer secuencialmente, sin cargar todo el archivo en RAM.
## Mantener intactos los identificadores y las secuencias.

python - <<'PY'
from pathlib import Path
import hashlib

proyecto = Path("/Volumes/Respaldo/secuencias/Christopher")
origen = proyecto / "humann_results/C6/C6_humann_temp/C6_bowtie2_unaligned.fa"
destino = proyecto / "diamond_chunks/C6/C6.part_0001.fa"
parcial = destino.with_suffix(".fa.partial")

limite = 4_000_000
cantidad = 0
sha = hashlib.sha256()

with origen.open("rb") as entrada, parcial.open("xb") as salida:
    for linea in entrada:
        if linea.startswith(b">"):
            if cantidad == limite:
                break
            cantidad += 1
        elif cantidad == 0:
            raise ValueError("El archivo no comienza con un encabezado FASTA.")

        salida.write(linea)
        sha.update(linea)

if cantidad != limite:
    raise SystemExit(
        f"ERROR: se esperaban {limite:,} lecturas; se encontraron {cantidad:,}."
    )

parcial.rename(destino)

destino.with_suffix(".sha256").write_text(
    f"{sha.hexdigest()}  {destino.name}\n"
)

print(f"Fragmento preparado: {cantidad:,} lecturas")
print(f"Tamaño: {destino.stat().st_size / 1024**3:.2f} GiB")
print(f"Archivo: {destino}")
PY

