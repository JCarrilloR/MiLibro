THREADS=12

## Se utilizarán 12 trabajadores.
## El consumo real de CPU dependerá de la etapa del análisis,
## la compresión de archivos y la velocidad del disco.

# 14.2. Verificar el adaptador de MetaPhlAn.

[[ -x "$WRAPPER" ]] || {
    echo "ERROR: falta el adaptador ejecutable: $WRAPPER"
    echo "Completar primero la sección 13.2."
    exit 1
}

# 14.3. Configurar el PATH para esta ejecución.

## El adaptador debe aparecer antes que el MetaPhlAn original.
## Después se priorizan HUMAnN y las dependencias de humannpip.
## La modificación del PATH solo afecta a esta sesión de zsh.

export PATH="$PROJECT_DIR/bin_wrappers:/Users/bio2/miniconda/envs/humannpip/bin:/Users/bio2/miniconda/envs/meta4/bin:$PATH"
rehash

# 14.4. Comprobar los programas.

command -v humann
humann --version

command -v metaphlan
metaphlan --version

command -v diamond
diamond --version

command -v bowtie2
bowtie2 --version

# 14.5. Verificar los archivos de entrada.

## Se requieren los dos extremos de C1 y su perfil taxonómico individual.
## No se utiliza la tabla combinada metaphlan_merged.tsv.

for FILE in \
    "$READ_DIR/C1_R1.fq.gz" \
    "$READ_DIR/C1_R2.fq.gz" \
    "$PROFILE"; do

    [[ -s "$FILE" ]] || {
        echo "ERROR: archivo ausente o vacío: $FILE"
        exit 1
    }
done

# 14.6. Comprobar las rutas de las bases funcionales.

[[ -d "$DB_ROOT/chocophlan" ]] || {
    echo "ERROR: no se encontró la carpeta de ChocoPhlAn."
    exit 1
}

[[ -s "$DB_ROOT/uniref/uniref50_201901b_full.dmnd" ]] || {
    echo "ERROR: no se encontró la base UniRef50 esperada."
    exit 1
}

## Estas comprobaciones verifican disponibilidad básica.
## La validación interna de las bases se realizará al ejecutar HUMAnN.

# 14.7. Evitar repetir una ejecución con las tres tablas principales.

## La existencia de las tablas no sustituye la revisión del registro
## y de las estadísticas de asignación funcional.

if [[ -s "$OUT_DIR/C1_genefamilies.tsv" &&
      -s "$OUT_DIR/C1_pathabundance.tsv" &&
      -s "$OUT_DIR/C1_pathcoverage.tsv" ]]; then

    echo "C1 ya tiene las tres tablas principales."
    echo "Revisar los resultados antes de repetir el análisis."
    exit 0
fi

mkdir -p "$INPUT_DIR" "$OUT_DIR"

# 14.8. Preparar la entrada conjunta de C1.

## HUMAnN recibirá un archivo con todas las lecturas R1 y R2.
## La concatenación no ensambla contigs ni fusiona secuencias.
## Las lecturas se analizarán como secuencias individuales.
## Los archivos R1 y R2 originales permanecerán intactos.

## Si la entrada conjunta ya existe y tiene contenido,
## se reutilizará para evitar repetir su preparación.
## Se asume que corresponde a las mismas entradas verificadas.

if [[ -e "$INPUT" ]]; then

    [[ -s "$INPUT" ]] || {
        echo "ERROR: la entrada conjunta existe, pero está vacía."
        exit 1
    }

    echo "Reutilizando: $INPUT"

else

    echo "Preparando entrada conjunta de C1..."

    ## Se escribe primero un archivo provisional.
    ## cat concatena los archivos gzip sin descomprimirlos.

    cat "$READ_DIR/C1_R1.fq.gz" "$READ_DIR/C1_R2.fq.gz" \
        > "$INPUT_DIR/C1.partial.gz"

    ## Comprobar que el archivo comprimido puede leerse completo.
    ## Esta comprobación puede tardar varios minutos.

    gzip -t "$INPUT_DIR/C1.partial.gz"

    ## Asignar el nombre definitivo solo si la comprobación termina bien.

    mv "$INPUT_DIR/C1.partial.gz" "$INPUT"
fi

# 14.9. Registrar versiones y parámetros.

RUN_ID="$(date +%Y%m%d_%H%M%S)"

{
    humann --version
    metaphlan --version
    diamond --version
    bowtie2 --version
} > "$OUT_DIR/C1.versions_${RUN_ID}.txt" 2>&1

{
    printf 'Input: %s\n' "$INPUT"
    printf 'Taxonomic profile: %s\n' "$PROFILE"
    printf 'Nucleotide database: %s\n' "$DB_ROOT/chocophlan"
    printf 'Protein database: %s\n' "$DB_ROOT/uniref"
    printf 'Search mode: uniref50\n'
    printf 'Threads: %s\n' "$THREADS"
    printf 'MetaPhlAn adapter: %s\n' "$WRAPPER"
} > "$OUT_DIR/C1.parameters_${RUN_ID}.txt"

# 14.10. Ejecutar o retomar HUMAnN.

## --taxonomic-profile reutiliza el perfil taxonómico de C1.
## --search-mode uniref50 corresponde a la base proteica instalada.
## --output-basename C1 establece el prefijo de los resultados.

## --resume permite reutilizar pasos intermedios completados.
## Solo debe emplearse manteniendo las mismas entradas,
## bases de datos y parámetros del análisis anterior.

## No se omiten la búsqueda nucleotídica ni la traducida.
## HUMAnN buscará primero contra los pangenomas seleccionados
## y después procesará las lecturas restantes mediante DIAMOND.

## caffeinate -i evita el reposo por inactividad durante la ejecución.
## tee muestra los mensajes en pantalla y guarda un registro nuevo.
## Los registros de intentos anteriores se conservarán.

caffeinate -i humann \
    --input "$INPUT" \
    --output "$OUT_DIR" \
    --output-basename C1 \
    --threads "$THREADS" \
    --resume \
    --search-mode uniref50 \
    --taxonomic-profile "$PROFILE" \
    --nucleotide-database "$DB_ROOT/chocophlan" \
    --protein-database "$DB_ROOT/uniref" \
    2>&1 | tee "$OUT_DIR/C1.console_${RUN_ID}.log"

# 14.11. Comprobar las salidas principales.

## genefamilies: abundancia de familias génicas.
## pathabundance: abundancia estimada de rutas metabólicas.
## pathcoverage: medida de cobertura de rutas inferida por HUMAnN.
## Las abundancias no deben interpretarse como porcentajes
## hasta realizar la normalización correspondiente.

for TABLE in genefamilies pathabundance pathcoverage; do
    FILE="$OUT_DIR/C1_${TABLE}.tsv"

    [[ -s "$FILE" ]] || {
        echo "ERROR: no se encontró la salida esperada: $FILE"
        exit 1
    }

    echo "Salida encontrada: $FILE"
done

echo "HUMAnN completado para C1."
echo "Revisar el registro y las estadísticas antes de continuar con C2–C8."
ZSH

