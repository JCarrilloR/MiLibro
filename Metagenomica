# 5. Limpieza de las lecturas metagenómicas con Cutadapt 5.1

## Se eliminarán los adaptadores Illumina cuando sean detectados.
## Se recortarán extremos 3′ de baja calidad con un umbral Q20.
## Se descartará el par si alguna lectura queda por debajo de 75 pb
## o contiene más de un 1 % de bases ambiguas (N).
## Se conservará la correspondencia entre R1 y R2.

#| Parámetro | Función |

#| `-q 20` | Recorta por calidad en el extremo 3′ de ambas lecturas |
#| `-m 75` | Exige una longitud final mínima de 75 pb |
#| `--max-n 0.01` | Permite como máximo 1 % de bases N |
#| `--pair-filter=any` | Descarta el par si cualquiera de sus lecturas falla un filtro |
#| `-j 8` | Utiliza ocho núcleos |

## No se realizará un recorte fijo del inicio de las lecturas.
## No se eliminarán colas poli-A ni se aplicará filtrado de rRNA.

zsh <<'ZSH'
set -euo pipefail

# 5.1. Definir las rutas del proyecto.

PROJECT_DIR="/Volumes/Respaldo/secuencias/Christopher"
IN_DIR="$PROJECT_DIR/01.RawData"
OUT_DIR="$PROJECT_DIR/cutadapt_results"

mkdir -p "$OUT_DIR"

# 5.2. Registrar la versión utilizada.

cutadapt --version > "$OUT_DIR/cutadapt_version.txt"

# 5.3. Localizar los 16 archivos R1.
## Cada R1 corresponde a una muestra y un carril.

R1_FILES=( "$IN_DIR"/C{1..8}/*_1.fq.gz(N) )

if (( ${#R1_FILES[@]} != 16 )); then
    echo "ERROR: se esperaban 16 archivos R1; se encontraron ${#R1_FILES[@]}."
    exit 1
fi

# 5.4. Verificar todos los pares antes de iniciar.

for R1 in "${R1_FILES[@]}"; do
    R2="${R1%_1.fq.gz}_2.fq.gz"
    if [[ ! -f "$R2" ]]; then
        echo "ERROR: falta el archivo R2: $R2"
        exit 1
    fi
done

# 5.5. Procesar cada par.
## Se conservarán los identificadores de muestra, flowcell y carril.
## Los resultados se guardarán comprimidos en una carpeta nueva.

for R1 in "${R1_FILES[@]}"; do
    R2="${R1%_1.fq.gz}_2.fq.gz"
    BASE="${R1:t}"
    BASE="${BASE%_1.fq.gz}"

    echo "Procesando: $BASE"

    cutadapt \
        -j 8 \
        -a AGATCGGAAGAGCACACGTCTGAACTCCAGTCA \
        -A AGATCGGAAGAGCGTCGTGTAGGGAAAGAGTGT \
        -q 20 \
        -m 75 \
        --max-n 0.01 \
        --trim-n \
        --overlap 5 \
        -e 0.1 \
        --pair-filter=any \
        --json "$OUT_DIR/${BASE}.cutadapt.json" \
        -o "$OUT_DIR/${BASE}_R1.trimmed.fq.gz" \
        -p "$OUT_DIR/${BASE}_R2.trimmed.fq.gz" \
        "$R1" "$R2" \
        > "$OUT_DIR/${BASE}.cutadapt.log" 2>&1

    echo "Completado: $BASE"
done

echo "Limpieza completada para los 16 pares."
echo "Resultados: $OUT_DIR"
ZSH

