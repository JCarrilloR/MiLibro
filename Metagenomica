cat > "/Volumes/Respaldo/secuencias/Christopher/bin_wrappers/metaphlan" <<'PY'
#!/Users/bio2/miniconda/envs/meta4/bin/python
import subprocess
import sys

comando = [
    "/Users/bio2/miniconda/envs/meta4/bin/python",
    "/Users/bio2/miniconda/envs/meta4/bin/metaphlan",
]
argumentos = sys.argv[1:]

if argumentos in (["--version"], ["-v"]):
    resultado = subprocess.run(
        comando + argumentos,
        stdout=subprocess.PIPE,
        stderr=subprocess.STDOUT,
        text=True,
    )

    if resultado.returncode:
        sys.stderr.write(resultado.stdout)
        sys.exit(resultado.returncode)

    for linea in resultado.stdout.splitlines():
        if linea.startswith("MetaPhlAn version "):
            print(linea)
            sys.exit(0)

    sys.stderr.write("No se pudo identificar la versión real de MetaPhlAn.\n")
    sys.exit(1)

sys.exit(subprocess.call(comando + argumentos))
PY

chmod +x "/Volumes/Respaldo/secuencias/Christopher/bin_wrappers/metaphlan"

