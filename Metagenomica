        --db_dir "$DB_DIR" \
        --index "$DB_INDEX" \
        --nproc "$THREADS" \
        --mapout "$OUT_DIR/${SAMPLE}.mapout.bz2" \
        -o "$OUT_DIR/${SAMPLE}.profile.txt" \
        > "$OUT_DIR/${SAMPLE}.metaphlan.log" 2>&1

    echo "Completado: $SAMPLE"
done

echo "MetaPhlAn completado para las ocho muestras."
echo "Resultados: $OUT_DIR"
ZSH

