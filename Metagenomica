# 7. Integración de los carriles de secuenciación por muestra

## La limpieza conservó aproximadamente el 99.66 % de las lecturas.
## Los archivos limpios mantienen una mediana de longitud de 150 pb
## y aprobaron las evaluaciones de calidad por base y adaptadores.

## Cada muestra fue secuenciada en dos carriles.
## Integraremos los R1 de ambos carriles en un archivo
## y los R2 en otro, manteniendo el mismo orden en ambos extremos.

## Esta operación concatena archivos; no ensambla secuencias
## ni fusiona las lecturas R1 y R2.
## Los archivos gzip concatenados conservan el formato comprimido.
## Los originales y los archivos de Cutadapt permanecerán disponibles.

zsh <<'ZSH'
set -euo pipefail

# 7.1. Definir las carpetas de entrada y salida.

PROJECT_DIR="/Volumes/Respaldo/secuencias/Christopher"
IN_DIR="$PROJECT_DIR/cutadapt_results"
OUT_DIR="$PROJECT_DIR/merged_reads"

mkdir -p "$OUT_DIR"

# 7.2. Comprobar las entradas y evitar sobrescribir resultados.
## Cada muestra debe tener dos R1, con sus respectivos R2.

for SAMPLE in C{1..8}; do
    R1_FILES=( "$IN_DIR"/${SAMPLE}_*_R1.trimmed.fq.gz(N) )

    if (( ${#R1_FILES[@]} != 2 )); then
        echo "ERROR: $SAMPLE debe tener exactamente dos archivos R1."
        exit 1
    fi

    for R1 in "${R1_FILES[@]}"; do
        R2="${R1%_R1.trimmed.fq.gz}_R2.trimmed.fq.gz"
        [[ -s "$R1" && -s "$R2" ]] || {
            echo "ERROR: archivo ausente o vacío en el par: $R1"
            exit 1
        }
    done

    for READ in R1 R2; do
        [[ ! -e "$OUT_DIR/${SAMPLE}_${READ}.fq.gz" ]] || {
            echo "ERROR: ya existe ${SAMPLE}_${READ}.fq.gz."
            exit 1
        }
    done
done

# 7.3. Integrar cada muestra.
## Los R2 se seleccionan siguiendo exactamente el orden de los R1.

for SAMPLE in C{1..8}; do
    R1_FILES=( "$IN_DIR"/${SAMPLE}_*_R1.trimmed.fq.gz(N) )
    R2_FILES=()

    for R1 in "${R1_FILES[@]}"; do
        R2_FILES+=( "${R1%_R1.trimmed.fq.gz}_R2.trimmed.fq.gz" )
    done

    echo "Integrando: $SAMPLE"

    cat "${R1_FILES[@]}" > "$OUT_DIR/${SAMPLE}_R1.fq.gz.part"
    cat "${R2_FILES[@]}" > "$OUT_DIR/${SAMPLE}_R2.fq.gz.part"

    # Comprobar la integridad gzip antes de dar por terminado el par.
    gzip -t "$OUT_DIR/${SAMPLE}_R1.fq.gz.part"
    gzip -t "$OUT_DIR/${SAMPLE}_R2.fq.gz.part"

    mv "$OUT_DIR/${SAMPLE}_R1.fq.gz.part" "$OUT_DIR/${SAMPLE}_R1.fq.gz"
    mv "$OUT_DIR/${SAMPLE}_R2.fq.gz.part" "$OUT_DIR/${SAMPLE}_R2.fq.gz"

    echo "Completado: ${SAMPLE}_R1.fq.gz y ${SAMPLE}_R2.fq.gz"
done

echo "Integración completada: ocho muestras, 16 archivos finales."
echo "Resultados: $OUT_DIR"
ZSH

