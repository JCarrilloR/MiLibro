# 1. Verificación de la integridad de los archivos de secuenciación

## 1.5. Entrar a la carpeta de datos originales.

cd "/Volumes/Respaldo/secuencias/Christopher/01.RawData"

## 1.6. Comparar el MD5 de cada archivo con el proporcionado por Novogene.
## Los archivos se leen comprimidos y por bloques para utilizar poca memoria.
## Se omiten líneas vacías y se aceptan distintos tipos de espacios.
## La comprobación puede tardar varios minutos porque lee los 32 archivos.

python - <<'PY'
from pathlib import Path
import hashlib
import sys

raiz = Path("/Volumes/Respaldo/secuencias/Christopher/01.RawData")
correctos = 0
problemas = 0

for numero in range(1, 9):
    carpeta = raiz / f"C{numero}"
    manifiesto = carpeta / "MD5.txt"
    print(f"\nVerificando C{numero}...", flush=True)

    if not manifiesto.is_file():
        print("ERROR: no se encontró MD5.txt", flush=True)
        problemas += 1
        continue

    registros = [
        linea.strip()
        for linea in manifiesto.read_text(encoding="utf-8-sig").splitlines()
        if linea.strip()
    ]

    if len(registros) != 4:
        print(f"AVISO: se esperaban 4 registros; se encontraron {len(registros)}.")
        problemas += 1

    for linea in registros:
        campos = linea.split(maxsplit=1)

        if len(campos) != 2:
            print(f"ERROR: línea no reconocida: {linea}")
            problemas += 1
            continue

        esperado, nombre = campos
        nombre = nombre.lstrip("*")
        archivo = carpeta / nombre

        if not archivo.is_file():
            print(f"NO ENCONTRADO: {nombre}", flush=True)
            problemas += 1
            continue

        try:
            huella = hashlib.md5()
            with archivo.open("rb") as entrada:
                for bloque in iter(lambda: entrada.read(8 * 1024 * 1024), b""):
                    huella.update(bloque)

            obtenido = huella.hexdigest()

            if obtenido == esperado.lower():
                print(f"OK: {nombre}", flush=True)
                correctos += 1
            else:
                print(f"NO COINCIDE: {nombre}", flush=True)
                print(f"  Esperado: {esperado}")
                print(f"  Obtenido: {obtenido}")
                problemas += 1

        except OSError as error:
            print(f"ERROR al leer {nombre}: {error}", flush=True)
            problemas += 1

print(f"\nArchivos correctos: {correctos}")
print(f"Problemas detectados: {problemas}")

if correctos == 32 and problemas == 0:
    print("VERIFICACIÓN COMPLETA: los 32 archivos coinciden con los MD5 originales.")
else:
    print("REVISAR: la verificación no está completa o se detectaron problemas.")
    sys.exit(1)
PY

