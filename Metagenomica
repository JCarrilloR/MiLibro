# 9.2. Verificar las entradas de las ocho muestras.
## Se comprueban todas antes de iniciar el procesamiento.

for SAMPLE in C{1..8}; do
    for READ in R1 R2; do
        FILE="$IN_DIR/${SAMPLE}_${READ}.fq.gz"
        [[ -s "$FILE" ]] || {
            echo "ERROR: archivo ausente o vacío: $FILE"
            exit 1
        }
    done

    # Evitar sobrescribir perfiles o mapeos existentes.
    for FILE in \
        "$OUT_DIR/${SAMPLE}.profile.txt" \
        "$OUT_DIR/${SAMPLE}.mapout.bz2"; do
        [[ ! -e "$FILE" ]] || {
            echo "ERROR: ya existe $FILE"
            exit 1
        }
    done
done

